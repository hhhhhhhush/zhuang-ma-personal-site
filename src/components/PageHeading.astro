---
interface Props {
  number?: string;
  label: string;
  title: string;
  description: string;
}
const { number = '', label, title, description } = Astro.props;
---

<header class="page-heading">
  <p class="eyebrow">
    {number && `${number} / `}
    {label}
  </p>
  <h1>{title}</h1>
  <p>{description}</p>
</header>
