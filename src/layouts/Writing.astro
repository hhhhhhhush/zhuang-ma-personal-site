---
import Base from './Base.astro';
import PostCard from '../components/PostCard.astro';
import { render } from 'astro:content';
import { profile, dateLabel, url, type Writing } from '../lib/content';
interface Props {
  entry: Writing;
  entries: Writing[];
  kind: 'blog' | 'knowledge';
}
const { entry, entries, kind } = Astro.props;
const { Content, headings } = await render(entry);
const index = entries.findIndex((e) => e.id === entry.id);
const newer = index > 0 ? entries[index - 1] : undefined;
const older = index >= 0 ? entries[index + 1] : undefined;
const related = entries
  .filter(
    (e) =>
      e.id !== entry.id &&
      (e.data.category === entry.data.category ||
        e.data.tags.some((t) => entry.data.tags.includes(t))),
  )
  .slice(0, 2);
---

<Base
  title={entry.data.seoTitle || entry.data.title}
  description={entry.data.seoDescription || entry.data.description}
  image={entry.data.cover}
  article
>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="article-heading">
    <a class="back-link" href={url(`/${kind}/`)}>
      ← {kind === 'blog' ? '全部手记' : '知识花园'}
    </a>
    <p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <div class="article-meta">
      <span>{profile.nameEn}</span>
      <time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time>
      {entry.data.updated && <span>更新于 {dateLabel(entry.data.updated)}</span>}
    </div>
    <div class="tags">
      {entry.data.tags.map((tag) => (
        <a href={`${url(`/${kind}/`)}?tag=${encodeURIComponent(tag)}`}>#{tag}</a>
      ))}
    </div>
  </header>
  {entry.data.cover && (
    <img
      class="article-cover"
      src={url(entry.data.cover)}
      alt={entry.data.title}
      width="1200"
      height="640"
      decoding="async"
    />
  )}
  <div class="article-layout">
    <article class="prose">
      <Content />
    </article>
    <aside class="toc">
      <details open>
        <summary>ON THIS PAGE / 目录</summary>
        <nav aria-label="文章目录">
          {headings
            .filter((h) => h.depth > 1 && h.depth <= 4)
            .map((h) => (
              <a href={`#${h.slug}`} style={`padding-left:${(h.depth - 2) * 12}px`}>
                {h.text}
              </a>
            ))}
        </nav>
      </details>
    </aside>
  </div>
  <nav class="article-pagination" aria-label="相邻文章">
    <div>
      {older && (
        <a href={url(`/${kind}/${older.id}/`)}>
          <span class="eyebrow">← 上一篇 · 更早</span>
          <h3>{older.data.title}</h3>
        </a>
      )}
    </div>
    <div>
      {newer && (
        <a href={url(`/${kind}/${newer.id}/`)}>
          <span class="eyebrow">下一篇 · 更新 →</span>
          <h3>{newer.data.title}</h3>
        </a>
      )}
    </div>
  </nav>
  {related.length > 0 && (
    <section class="home-section">
      <div class="section-heading">
        <h2>继续探索</h2>
      </div>
      <div class="post-grid">
        {related.map((e) => (
          <PostCard entry={e} kind={kind} />
        ))}
      </div>
    </section>
  )}
</Base>
<script>
  const bar = document.querySelector<HTMLElement>('.reading-progress')!;
  const article = document.querySelector<HTMLElement>('.prose')!;
  let queued = false;
  function updateProgress() {
    const start = article.getBoundingClientRect().top + window.scrollY;
    const range = article.offsetHeight - window.innerHeight;
    const percent =
      range <= 0 ? (window.scrollY >= start ? 1 : 0) : (window.scrollY - start) / range;
    bar.style.transform = `scaleX(${Math.min(1, Math.max(0, percent))})`;
    queued = false;
  }
  addEventListener(
    'scroll',
    () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true },
  );
  addEventListener('resize', updateProgress);
  updateProgress();
  const headings = document.querySelectorAll('.prose :is(h2,h3,h4)');
  const observer = new IntersectionObserver(
    (items) => {
      for (const item of items)
        if (item.isIntersecting) {
          document
            .querySelectorAll('.toc a')
            .forEach((a) =>
              a.classList.toggle('active', a.getAttribute('href') === `#${item.target.id}`),
            );
        }
    },
    { rootMargin: '-10% 0px -70% 0px' },
  );
  headings.forEach((h) => observer.observe(h));
</script>
