---
import Base from '../layouts/Base.astro';
import GardenArt from '../components/GardenArt.astro';
import PostCard from '../components/PostCard.astro';
import { profile, posts, notes, projects, url } from '../lib/content';
const allPosts = await posts();
const selected = [
  ...allPosts.filter((p) => p.data.featured),
  ...allPosts.filter((p) => !p.data.featured),
].slice(0, 3);
const selectedProjects = (await projects()).filter((p) => p.data.featured).slice(0, 2);
const allNotes = await notes();
const selectedNotes = [
  ...allNotes.filter((n) => n.data.featured),
  ...allNotes.filter((n) => !n.data.featured),
].slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="tiny-dot"></span> THE PERSONAL SPACE OF {profile.nameEn.toUpperCase()}
      </p>
      <h1>
        {profile.heroTitle.split('\n').map((line, i) => (
          <span class:list={{ 'serif-italic': i % 2 === 1 }}>{line}</span>
        ))}
      </h1>
      <p class="hero-subtitle">{profile.heroSubtitle}</p>
      <p class="hero-bio">{profile.bio}</p>
      <div class="hero-actions">
        <a class="button" href={url('/about/')}>
          认识我 <span>↗</span>
        </a>
        <a class="text-link" href={url('/blog/')}>
          阅读我的手记 <span>→</span>
        </a>
      </div>
    </div>
    <GardenArt />
  </section>
  <div class="interest-strip">
    <span>A FEW THINGS I’M EXPLORING</span>
    <div>
      {profile.focus.map((item) => (
        <span>{item}</span>
      ))}
    </div>
    <span class="small-note">Always a work in progress ↗</span>
  </div>
  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / THE JOURNAL</p>
        <h2>
          Notes along the way<span class="heading-zh">最近的记录</span>
        </h2>
      </div>
      <a class="text-link" href={url('/blog/')}>
        全部文章 ↗
      </a>
    </div>
    <div class="post-grid">
      {selected.map((entry) => (
        <PostCard entry={entry} />
      ))}
    </div>
    <p class="sample-note">起步手记 · 当前文章为网站内容与排版示例，不代表个人真实经历。</p>
  </section>
  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / THE WORKBENCH</p>
        <h2>
          Things taking shape<span class="heading-zh">探索与实践</span>
        </h2>
      </div>
      <a class="text-link" href={url('/projects/')}>
        全部项目 ↗
      </a>
    </div>
    <div class="project-grid">
      {selectedProjects.map((entry, index) => (
        <a class="project-tile" href={url(`/projects/${entry.id}/`)}>
          <div class:list={['project-visual', `visual-${index}`]}>
            {entry.data.cover ? (
              <img src={url(entry.data.cover)} alt="" width="800" height="440" loading="lazy" />
            ) : (
              <>
                <span class="visual-index">EXPLORATION / 0{index + 1}</span>
                <div class="visual-title">
                  {entry.data.title.replace('（示例）', '')}
                  <span>↗</span>
                </div>
                <span class="visual-caption">{entry.data.stack.join(' · ')}</span>
                <div class="visual-lines" aria-hidden="true"></div>
              </>
            )}
          </div>
          <div class="project-caption">
            <h3>{entry.data.title}</h3>
            <span class="status">{entry.data.projectStatus}</span>
          </div>
          <p>{entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="garden-section">
    <div>
      <p class="eyebrow">03 / THE DIGITAL GARDEN</p>
      <h2>
        Ideas need
        <br />
        <em>room to grow.</em>
      </h2>
      <p>
        不必等到完美才开始记录。
        <br />
        让零散的知识，慢慢长成自己的理解。
      </p>
      <a class="text-link" href={url('/knowledge/')}>
        走进知识花园 ↗
      </a>
    </div>
    <div class="note-list">
      {selectedNotes.map((entry, i) => (
        <a href={url(`/knowledge/${entry.id}/`)}>
          <span class="note-number">0{i + 1}</span>
          <div>
            <span class="eyebrow">{entry.data.category}</span>
            <h3>{entry.data.title}</h3>
            <span class="small-note">
              {entry.data.maturity} · {entry.data.tags.join(' / ')}
            </span>
          </div>
          <span>↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="closing-note">
    <span class="eyebrow">LET’S STAY IN TOUCH</span>
    <h2>Good things begin with a conversation.</h2>
    <a class="text-link" href={url('/contact/')}>
      打个招呼 ↗
    </a>
  </section>
</Base>
