---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import { profile, site, url } from '../lib/content';
---

<Base title="About · 关于我" description={profile.bio}>
  <PageHeading
    label="BEHIND THE PAGES"
    title="A little about me."
    description="一个持续学习、保持好奇的人。一份还在书写中的自我介绍。"
  />
  <section class="about-intro">
    <img
      src={url(profile.avatar || site.defaultAvatar)}
      width="160"
      height="160"
      alt={`${profile.nameEn} 的头像`}
    />
    <div>
      <p class="eyebrow">{profile.nameZh}</p>
      <h2>{profile.nameEn}</h2>
      <p>{profile.introduction}</p>
      <p>{profile.introductionZh}</p>
      <p lang="en" class="muted">
        {profile.introductionEn}
      </p>
    </div>
  </section>
  <section class="about-grid">
    {[
      ['技能 / SKILLS', profile.skills],
      ['兴趣 / INTERESTS', profile.interests],
      ['关注 / FOCUS', profile.focus],
      ['正在学习 / NOW', profile.learning],
    ].map(([title, items]) => (
      <div>
        <h2>{title}</h2>
        <ul>
          {(items as string[]).map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </section>
  <section class="timeline-section">
    <p class="eyebrow">THE JOURNEY</p>
    <h2>经历，慢慢积累。</h2>
    <div class="timeline">
      {profile.experiences.map((item) => (
        <div>
          <span>{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
  <a class="text-link" href={url('/contact/')}>
    联系我 ↗
  </a>
</Base>
